from __future__ import annotations

import json
import os
import re
import secrets
import sqlite3
from pathlib import Path
from typing import Any

from fastapi import FastAPI, File, HTTPException, UploadFile
from fastapi.responses import FileResponse
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field
from .database import create_tables

BASE_DIR = Path(__file__).resolve().parents[1]
UPLOAD_DIR = Path(os.getenv("UPLOAD_DIR", BASE_DIR / "uploads"))
DATABASE_PATH = Path(os.getenv("DATABASE_PATH", BASE_DIR / "careerlens.db"))
FRONTEND_URL = os.getenv("FRONTEND_URL", "http://localhost:5173")
MAX_UPLOAD_BYTES = 10 * 1024 * 1024

SKILL_ALIASES = {
    "js": "JavaScript", "javascript": "JavaScript", "reactjs": "React", "react.js": "React",
    "nodejs": "Node.js", "node.js": "Node.js", "ml": "Machine Learning", "ai": "Artificial Intelligence",
    "sklearn": "Scikit-learn", "scikit learn": "Scikit-learn", "scikit-learn": "Scikit-learn",
    "aws": "AWS", "docker": "Docker", "python": "Python", "sql": "SQL", "pandas": "Pandas",
    "typescript": "TypeScript", "mongodb": "MongoDB", "git": "Git", "graphql": "GraphQL",
    "deep learning": "Deep Learning", "statistics": "Statistics", "cloud": "Cloud",
}
CAREERS = [
    {"id": "data-scientist", "title": "Data Scientist", "description": "Turn data into decisions with statistical and machine learning methods.", "skills": ["Python", "SQL", "Machine Learning", "Statistics", "Pandas", "Scikit-learn"]},
    {"id": "ml-engineer", "title": "Machine Learning Engineer", "description": "Build, deploy, and operate reliable machine learning systems.", "skills": ["Python", "Machine Learning", "Deep Learning", "SQL", "Git", "Docker", "Cloud", "MLOps"]},
    {"id": "backend-developer", "title": "Backend Developer", "description": "Design APIs and services that power dependable products.", "skills": ["Python", "SQL", "Git", "Docker", "REST APIs", "Cloud"]},
    {"id": "frontend-developer", "title": "Frontend Developer", "description": "Create accessible, responsive interfaces for the web.", "skills": ["JavaScript", "React", "TypeScript", "Git", "REST APIs", "GraphQL"]},
]
QUESTIONS = [
    {"id": "python-1", "career": "ml-engineer", "skill": "Python", "difficulty": "beginner", "question": "Which Python type stores key-value pairs?", "options": ["List", "Dictionary", "Tuple", "Set"], "correct": 1},
    {"id": "ml-1", "career": "ml-engineer", "skill": "Machine Learning", "difficulty": "advanced", "question": "What does cross-validation primarily estimate?", "options": ["Training speed", "Generalization performance", "Feature count", "Memory usage"], "correct": 1},
    {"id": "sql-1", "career": "ml-engineer", "skill": "SQL", "difficulty": "expert", "question": "Which clause filters grouped aggregate results?", "options": ["WHERE", "ORDER BY", "HAVING", "LIMIT"], "correct": 2},
    {"id": "docker-1", "career": "ml-engineer", "skill": "Docker", "difficulty": "advanced", "question": "What is a Docker image?", "options": ["A running process", "A read-only application template", "A network", "A volume"], "correct": 1},
    {"id": "react-1", "career": "frontend-developer", "skill": "React", "difficulty": "beginner", "question": "Which hook stores component state?", "options": ["useState", "useEffect", "useRef", "useMemo"], "correct": 0},
]


def db() -> sqlite3.Connection:
    DATABASE_PATH.parent.mkdir(parents=True, exist_ok=True)
    connection = sqlite3.connect(DATABASE_PATH)
    connection.row_factory = sqlite3.Row
    return connection


def init_db() -> None:
    create_tables()
    with db() as connection:
        connection.executescript("""
        CREATE TABLE IF NOT EXISTS resumes (id TEXT PRIMARY KEY, filename TEXT NOT NULL, file_type TEXT NOT NULL, path TEXT NOT NULL, text TEXT DEFAULT '', analysis TEXT DEFAULT '{}');
        CREATE TABLE IF NOT EXISTS selections (user_id TEXT PRIMARY KEY, career_id TEXT NOT NULL);
        CREATE TABLE IF NOT EXISTS assessments (id TEXT PRIMARY KEY, user_id TEXT NOT NULL, career_id TEXT NOT NULL, difficulty TEXT NOT NULL, questions TEXT NOT NULL, result TEXT DEFAULT '{}');
        """)


def clean_skill(value: str) -> str:
    return SKILL_ALIASES.get(value.lower().strip(), value.strip().title())


def extract_skills(text: str) -> list[str]:
    lowered = text.lower()
    found = []
    for alias, normalized in SKILL_ALIASES.items():
        if re.search(r"(?<![a-z])" + re.escape(alias) + r"(?![a-z])", lowered) and normalized not in found:
            found.append(normalized)
    return found


def parse_document(path: Path, file_type: str) -> str:
    try:
        if file_type == "application/pdf" or path.suffix.lower() == ".pdf":
            import fitz
            return "\n".join(page.get_text() for page in fitz.open(path))
        if path.suffix.lower() == ".docx":
            from docx import Document
            return "\n".join(paragraph.text for paragraph in Document(path).paragraphs)
        return path.read_text(errors="ignore")
    except Exception as error:
        raise HTTPException(422, detail={"code": "RESUME_PARSE_ERROR", "message": "Unable to process the uploaded resume."}) from error


def analysis_for(text: str) -> dict[str, Any]:
    skills = extract_skills(text)
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    score = min(100, 45 + len(skills) * 7 + min(20, len(lines) // 5))
    sections = {name: [] for name in ("education", "experience", "projects", "certifications", "achievements")}
    current = None
    for line in lines:
        normalized = line.lower().rstrip(":")
        current = next((name for name in sections if name in normalized), current)
        if current and normalized != current:
            sections[current].append(line)
    return {"score": score, "status": "complete", "skills": [{"id": re.sub(r"[^a-z0-9]+", "-", skill.lower()).strip("-"), "name": skill, "category": "Technical", "confidence": 78, "claimLevel": "Intermediate"} for skill in skills], "keywords": skills, "strengths": ["Relevant technical vocabulary detected", "Resume content is machine-readable"], "improvements": ["Add measurable outcomes to experience bullets", "Tailor keywords to the selected career"], "personal": {}, **sections}


class CareerRequest(BaseModel):
    resume_id: str


class CareerSelection(BaseModel):
    career_id: str


class SkillGapRequest(BaseModel):
    resume_id: str
    career_id: str


class AssessmentRequest(BaseModel):
    resume_id: str
    career_id: str
    difficulty: str = Field(pattern="^(beginner|advanced|expert)$")


class Answer(BaseModel):
    question_id: str
    answer: int


class Submission(BaseModel):
    answers: list[Answer]


app = FastAPI(title="CareerLens AI API", version="1.0.0")
app.add_middleware(CORSMiddleware, allow_origins=[FRONTEND_URL], allow_credentials=True, allow_methods=["*"], allow_headers=["*"])


@app.on_event("startup")
def startup() -> None:
    UPLOAD_DIR.mkdir(parents=True, exist_ok=True)
    init_db()


@app.get("/api/health")
def health() -> dict[str, str]:
    return {"status": "ok", "service": "CareerLens AI API"}


@app.post("/api/resumes/upload")
async def upload_resume(resume: UploadFile = File(...)) -> dict[str, Any]:
    suffix = Path(resume.filename or "").suffix.lower()
    allowed = {".pdf": "application/pdf", ".docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", ".doc": "application/msword"}
    if suffix not in allowed:
        raise HTTPException(400, detail={"code": "INVALID_RESUME_TYPE", "message": "Upload a PDF or DOCX resume."})
    content = await resume.read()
    if not content or len(content) > MAX_UPLOAD_BYTES:
        raise HTTPException(400, detail={"code": "INVALID_RESUME_SIZE", "message": "Resume must be between 1 byte and 10 MB."})
    resume_id = secrets.token_urlsafe(12)
    destination = UPLOAD_DIR / f"{resume_id}{suffix}"
    destination.write_bytes(content)
    with db() as connection:
        connection.execute("INSERT INTO resumes(id, filename, file_type, path) VALUES (?, ?, ?, ?)", (resume_id, resume.filename or destination.name, allowed[suffix], str(destination)))
    return {"resume_id": resume_id, "filename": resume.filename, "file_type": allowed[suffix], "file_size": len(content), "status": "uploaded"}


@app.post("/api/resumes/{resume_id}/analyze")
def analyze_resume(resume_id: str) -> dict[str, Any]:
    with db() as connection:
        row = connection.execute("SELECT * FROM resumes WHERE id = ?", (resume_id,)).fetchone()
        if not row:
            raise HTTPException(404, detail={"code": "RESUME_NOT_FOUND", "message": "Resume not found."})
        text = parse_document(Path(row["path"]), row["file_type"])
        analysis = analysis_for(text)
        connection.execute("UPDATE resumes SET text = ?, analysis = ? WHERE id = ?", (text, json.dumps(analysis), resume_id))
    return {"resume_id": resume_id, "analysis_status": "complete", "resume_score": analysis["score"], **analysis}


@app.get("/api/resumes/{resume_id}")
def get_resume(resume_id: str) -> dict[str, Any]:
    with db() as connection:
        row = connection.execute("SELECT id, filename, file_type, analysis FROM resumes WHERE id = ?", (resume_id,)).fetchone()
    if not row:
        raise HTTPException(404, detail={"code": "RESUME_NOT_FOUND", "message": "Resume not found."})
    return {"resume_id": row["id"], "filename": row["filename"], "file_type": row["file_type"], "analysis_status": "complete" if json.loads(row["analysis"] or "{}").get("status") else "uploaded"}


@app.get("/api/resumes/{resume_id}/preview")
def preview_resume(resume_id: str):
    with db() as connection:
        row = connection.execute("SELECT path, filename, file_type FROM resumes WHERE id = ?", (resume_id,)).fetchone()
    if not row or not Path(row["path"]).is_file():
        raise HTTPException(404, detail={"code": "RESUME_NOT_FOUND", "message": "Resume preview is unavailable."})
    media_type = row["file_type"] if row["file_type"] == "application/pdf" else "application/octet-stream"
    return FileResponse(row["path"], media_type=media_type, filename=row["filename"])


def resume_analysis(resume_id: str) -> dict[str, Any]:
    with db() as connection:
        row = connection.execute("SELECT analysis FROM resumes WHERE id = ?", (resume_id,)).fetchone()
    if not row:
        raise HTTPException(404, detail={"code": "RESUME_NOT_FOUND", "message": "Resume not found."})
    return json.loads(row["analysis"] or "{}")


@app.get("/api/resumes/{resume_id}/skills")
def resume_skills(resume_id: str) -> dict[str, Any]:
    analysis = resume_analysis(resume_id)
    return {"skills": analysis.get("skills", [])}


@app.get("/api/careers")
def careers() -> list[dict[str, Any]]:
    return [{"id": career["id"], "title": career["title"], "description": career["description"], "requiredSkills": career["skills"]} for career in CAREERS]


@app.post("/api/careers/recommend")
def recommend_careers(request: CareerRequest) -> dict[str, Any]:
    skills = {item["name"] for item in resume_analysis(request.resume_id).get("skills", [])}
    results = []
    for career in CAREERS:
        matched = [skill for skill in career["skills"] if skill in skills]
        missing = [skill for skill in career["skills"] if skill not in skills]
        results.append({"id": career["id"], "title": career["title"], "description": career["description"], "score": round(len(matched) / len(career["skills"]) * 100), "status": "Strong Match" if len(matched) / len(career["skills"]) >= .6 else "Potential Match", "matchedSkills": matched, "missingSkills": missing})
    return {"recommendations": sorted(results, key=lambda item: item["score"], reverse=True)}


@app.post("/api/users/{user_id}/career")
def select_career(user_id: str, request: CareerSelection) -> dict[str, str]:
    if request.career_id not in {career["id"] for career in CAREERS}:
        raise HTTPException(404, detail={"code": "CAREER_NOT_FOUND", "message": "Career not found."})
    with db() as connection:
        connection.execute("INSERT INTO selections(user_id, career_id) VALUES (?, ?) ON CONFLICT(user_id) DO UPDATE SET career_id=excluded.career_id", (user_id, request.career_id))
    return {"user_id": user_id, "career_id": request.career_id}


@app.post("/api/skill-gap/analyze")
def skill_gap(request: SkillGapRequest) -> dict[str, Any]:
    skills = {item["name"] for item in resume_analysis(request.resume_id).get("skills", [])}
    career = next((item for item in CAREERS if item["id"] == request.career_id), None)
    if not career:
        raise HTTPException(404, detail={"code": "CAREER_NOT_FOUND", "message": "Career not found."})
    have = [skill for skill in career["skills"] if skill in skills]
    missing = [skill for skill in career["skills"] if skill not in skills]
    groups = [{"level": level, "skills": [skill for index, skill in enumerate(missing) if ("HIGH" if index < 2 else "MEDIUM" if index < 5 else "LOW") == level]} for level in ("HIGH", "MEDIUM", "LOW")]
    return {"overallMatch": round(len(have) / len(career["skills"]) * 100), "haveSkills": have, "missingSkills": missing, "priorities": groups}


@app.post("/api/recommendations/skills")
def recommendations(request: SkillGapRequest) -> list[dict[str, Any]]:
    gap = skill_gap(request)
    return [{"skill": skill, "priority": next(group["level"] for group in gap["priorities"] if skill in group["skills"]), "why": "Required for the selected career but not detected in the resume.", "path": [f"Study {skill} fundamentals", f"Build a small {skill} project"]} for skill in gap["missingSkills"]]


@app.post("/api/assessments/generate")
def generate_assessment(request: AssessmentRequest) -> dict[str, Any]:
    selected = [question for question in QUESTIONS if question["career"] == request.career_id and question["difficulty"] == request.difficulty]
    if not selected:
        selected = [question for question in QUESTIONS if question["career"] == request.career_id] or QUESTIONS[:2]
    assessment_id = secrets.token_urlsafe(12)
    with db() as connection:
        connection.execute("INSERT INTO assessments VALUES (?, ?, ?, ?, ?, ?)", (assessment_id, "demo-user", request.career_id, request.difficulty, json.dumps(selected), "{}"))
    public = [{key: question[key] for key in ("id", "skill", "difficulty", "question", "options")} for question in selected]
    return {"assessment_id": assessment_id, "career": request.career_id, "difficulty": request.difficulty, "questions": public}


@app.post("/api/assessments/{assessment_id}/submit")
def submit_assessment(assessment_id: str, submission: Submission) -> dict[str, Any]:
    with db() as connection:
        row = connection.execute("SELECT * FROM assessments WHERE id = ?", (assessment_id,)).fetchone()
        if not row:
            raise HTTPException(404, detail={"code": "ASSESSMENT_NOT_FOUND", "message": "Assessment not found."})
        questions = json.loads(row["questions"])
        answer_map = {answer.question_id: answer.answer for answer in submission.answers}
        correct = sum(answer_map.get(question["id"]) == question["correct"] for question in questions)
        result = {"score": round(correct / len(questions) * 100), "correct": correct, "incorrect": len(questions) - correct, "total": len(questions), "skill_scores": {question["skill"]: round(100 if answer_map.get(question["id"]) == question["correct"] else 0) for question in questions}}
        connection.execute("UPDATE assessments SET result = ? WHERE id = ?", (json.dumps(result), assessment_id))
    return result


def latest_result() -> dict[str, Any]:
    with db() as connection:
        row = connection.execute("SELECT result FROM assessments WHERE result != '{}' ORDER BY rowid DESC LIMIT 1").fetchone()
    return json.loads(row["result"]) if row else {"score": 0, "skill_scores": {}}


@app.get("/api/confidence/{user_id}")
def confidence(user_id: str) -> list[dict[str, Any]]:
    result = latest_result()
    return [{"skill": skill, "resume_evidence": 78, "assessment_score": score, "confidence_score": round((78 + score) / 2), "confidence_level": "High Confidence" if score >= 76 else "Developing"} for skill, score in result.get("skill_scores", {}).items()]


@app.get("/api/skills/claim-vs-actual/{user_id}")
def claims(user_id: str) -> list[dict[str, Any]]:
    return [{"skill": item["skill"], "resumeClaim": "Intermediate", "assessment": item["assessment_score"], "confidence": item["confidence_score"], "status": "Well Supported" if item["confidence_score"] >= 70 else "Needs Validation"} for item in confidence(user_id)]


@app.get("/api/career-readiness/{user_id}")
def readiness(user_id: str) -> dict[str, Any]:
    result = latest_result()
    assessment_score = result.get("score", 0)
    return {"career": "Machine Learning Engineer", "score": round((70 + 60 + assessment_score + 65) / 4), "status": "Good Preparation", "breakdown": {"resume_quality": 70, "skill_match": 60, "assessment": assessment_score, "confidence": 65}, "strengths": ["Resume is parseable", "Assessment results are recorded"], "improvements": ["Close the highest-priority skill gaps"], "nextSteps": [{"title": "Practice missing skills", "reason": "High-priority skill gap", "action": "Open recommendations", "link": "/recommendations"}]}


@app.get("/api/analytics/dashboard/{user_id}")
def analytics(user_id: str) -> dict[str, Any]:
    result = latest_result()
    return {"resume_score": 70, "skills_detected": len(result.get("skill_scores", {})), "career_match": 60, "skill_gap_count": 4, "assessment_score": result.get("score", 0), "confidence_score": 65, "career_readiness": readiness(user_id)["score"]}
